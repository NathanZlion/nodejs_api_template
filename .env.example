# Server Configuration
PORT=3000
NODE_ENV=development

# Client Configuration
CLIENT_FRONTEND_URL=http://localhost:3000
ALLOWED_CLIENT_URLS=http://localhost:3000,http://example.com

# JWT Secrets
JWT_ACCESS_SECRET=your-access-secret
JWT_REFRESH_SECRET=your-refresh-secret
JWT_RESET_PASSWORD_SECRET=your-reset-password-secret
JWT_REGISTRATION_SECRET=your-registration-secret

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_SECURE=false

# Seed Admin Credentials
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin-password

# Cache Database Configuration
CACHE_DB_HOST=localhost
CACHE_DB_PORT=6379
CACHE_DB_PASSWORD=your-cache-password

# MongoDB Configuration
MONGODB_CONNECTION_STRING=mongodb://localhost:27017/your-database